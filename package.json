{
  "name": "@geoffreyr/n8n-nodes-pushover-with-encryption",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "n8n community node for Pushover with optional client-side field encryption (gzip + AES-256-CBC + HMAC-SHA256) per Pushover's encrypted-message spec",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pushover",
    "encryption",
    "aes-256-cbc",
    "hmac-sha256",
    "notifications"
  ],
  "license": "MIT",
  "homepage": "https://github.com/geofox/n8n-nodes-pushover-with-encryption",
  "author": {
    "name": "Geoffrey Richard",
    "email": "pivots-plaque-5z@icloud.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geofox/n8n-nodes-pushover-with-encryption.git"
  },
  "bugs": {
    "url": "https://github.com/geofox/n8n-nodes-pushover-with-encryption/issues"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials __tests__ --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/PushoverWithEncryptionApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Pushover/PushoverWithEncryption.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^1.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "n8n-workflow": "^3.2.1",
    "prettier": "^3.10.1",
    "release-it": "^21.1.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
